# פלטי בנייה של TypeScript project references — לעולם לא בעקיבה (תיקון CI)
# tsbuildinfo הוא מצב מקומי מכונה-תלוי; פלטי src/ הם שאריות משלב 7.
*.tsbuildinfo
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
# חריג מכוון: הצהרות טיפוסים לתלויות ספק ללא טיפוסים (wawoff2) — קובצי מקור
# שנכתבו ביד, לא פלט בנייה (שלב 34; תיקון CI סבב י"א — בלעדיו הקובץ לא
# היה מועלה לעקיבה והבנייה בשיבוט טרה נכשלה ב-TS7016).
!packages/*/src/vendor.d.ts

# פלט ריצות ייחוס של המאמתים (מועלה כ-artifact ב-CI; אינו נכנס לעקיבה)
artifacts/

# Playwright (שלב 85)
test-results/
playwright-report/
