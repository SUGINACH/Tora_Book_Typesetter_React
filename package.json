{
  "name": "tora-book-typesetter-react",
  "version": "1.0.0",
  "description": "Torah book typesetting system — TypeScript + React + Vite + Tauri",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:component": "vitest run --dir tests/component",
    "test:e2e": "playwright test",
    "audit:smoke": "tsx scripts/geometry-audit-cli.ts --input public/widow-orphan.txt --fail-on HIGH",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "deploy:pages": "gh-pages -d dist -b gh-pages -m \"Deploy to GitHub Pages\"",
    "build:packages": "tsc -b packages/tsconfig.json",
    "typecheck:packages": "tsc -b packages/tsconfig.json --force",
    "verify:workspaces": "node scripts/migration/verify-workspaces.mjs",
    "lint:packages": "eslint packages",
    "deps:check": "depcruise packages --config .dependency-cruiser.cjs",
    "verify:deps": "node scripts/migration/verify-dependency-rules.mjs",
    "verify:parser": "node scripts/migration/verify-parser.mjs",
    "verify:unicode": "node scripts/migration/verify-unicode.mjs",
    "verify:brackets": "node scripts/migration/verify-brackets.mjs",
    "verify:notes": "node scripts/migration/verify-notes.mjs",
    "verify:text-audit": "node scripts/migration/verify-text-audit.mjs",
    "test:packages": "vitest run --config vitest.packages.config.ts",
    "verify:measurement-api": "node scripts/migration/verify-measurement-api.mjs",
    "verify:fonts-manifest": "node scripts/migration/verify-fonts-manifest.mjs",
    "gen:fonts-manifest": "node scripts/migration/gen-fonts-manifest.mjs",
    "verify:harfbuzz": "node scripts/migration/verify-harfbuzz-provider.mjs",
    "verify:enforcement": "node scripts/migration/verify-enforcement.mjs",
    "verify:cache": "node scripts/migration/verify-shaping-cache.mjs",
    "verify:uax14": "node scripts/migration/verify-uax14.mjs",
    "gen:uax14-tables": "node scripts/migration/gen-uax14-tables.mjs",
    "verify:layout-ir": "node scripts/migration/verify-layout-ir.mjs",
    "verify:typeset-contract": "node scripts/migration/verify-typeset-contract.mjs",
    "verify:layout-engine": "node scripts/migration/verify-layout-engine.mjs",
    "verify:render-html": "node scripts/migration/verify-render-html.mjs",
    "engine:layout": "node packages/cli/dist/main.js",
    "engine:audit": "node packages/cli/dist/main.js",
    "engine:verify": "node scripts/migration/verify-e2e-skeleton.mjs",
    "verify:line-battery": "node scripts/migration/verify-line-battery.mjs",
    "verify:next-path": "node scripts/migration/verify-next-path.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "mammoth": "^1.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "autoprefixer": "^10.4.19",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "fast-check": "^4.10.2",
    "gh-pages": "^6.1.0",
    "harfbuzzjs": "1.6.4",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.18.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "wawoff2": "2.0.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
