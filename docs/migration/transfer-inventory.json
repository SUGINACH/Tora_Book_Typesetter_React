  "decisions": [
    {
      "id": "D-001",
      "subject": "רישוי אוסף 1,760 הגופנים המצורפים (fonts/*.woff2)",
      "decision": "מועבר בשלמות, כמו שהוא",
      "reason": "תנאי התאימות של התכנית דורש את מלוא הסט; בתוכנה הישנה לא תועד רישיון לפי משפחה, והאוסף שימש בפועל את המערכת (רשימות priority/extended + בורר הגופנים).",
      "mitigation": "מניפסט עם SHA-256 לכל קובץ מאפשר subset עתידי לפי שימוש בפועל; סיכון מתועד באפיון §21 (גופנים רבים ורישיונות)."
    },
    {
      "id": "D-002",
      "subject": "Guttman-Rashi-Normal.woff2",
      "decision": "מועבר כמו שהוא",
      "reason": "נחוץ לתאימות מלאה (גופן רש\"י להערות); רישיון לא תועד במקור.",
      "mitigation": "מסומן במניפסט עם hash; ייבדק מול הבעלים לפני הפצה ציבורית (שלב 99)."
    },
    {
      "id": "D-003",
